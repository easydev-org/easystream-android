# Build the Android easystream APK with the SHARED web UI packaged.
#
# Base is an official Docker Hub image (eclipse-temurin = library namespace); the
# Android SDK + gradle are installed here because there is no official Android
# SDK image.
#
# Plain, self-contained build: no proxy settings, no private registries, no
# mirror addresses. It behaves identically on a laptop, on CI, and in a cluster.
# Egress configuration, if any, belongs to the builder.
#
#   docker build -f Containerfile.build .
ARG REGISTRY=docker.io/library
FROM ${REGISTRY}/eclipse-temurin:21-jdk

ARG WEBUI_REF=main
ENV ANDROID_SDK_ROOT=/opt/android-sdk ANDROID_HOME=/opt/android-sdk \
    GRADLE_VERSION=8.13 \
    DEBIAN_FRONTEND=noninteractive

# Debian packages from Aliyun over HTTPS. eclipse-temurin:21-jdk is bookworm.
# HTTPS rather than http: some egress proxies refuse plain http:// and report it
# as a missing Release file.
RUN rm -f /etc/apt/sources.list.d/* /etc/apt/sources.list \
    && printf 'deb https://mirrors.aliyun.com/debian bookworm main\n' > /etc/apt/sources.list \
    && printf 'deb https://mirrors.aliyun.com/debian bookworm-updates main\n' >> /etc/apt/sources.list \
    && echo 'Acquire::Retries "5";' > /etc/apt/apt.conf.d/80-retries \
    && apt-get update && apt-get install -y --no-install-recommends \
      curl unzip ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Android SDK: cmdline-tools + the platform/build-tools the app compiles against.
RUN mkdir -p "$ANDROID_SDK_ROOT/cmdline-tools" \
    && curl -fsSL -o /tmp/cmdtools.zip \
         "https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip" \
    && unzip -q /tmp/cmdtools.zip -d "$ANDROID_SDK_ROOT/cmdline-tools" \
    && mv "$ANDROID_SDK_ROOT/cmdline-tools/cmdline-tools" "$ANDROID_SDK_ROOT/cmdline-tools/latest" \
    && rm -f /tmp/cmdtools.zip \
    && yes | "$ANDROID_SDK_ROOT/cmdline-tools/latest/bin/sdkmanager" --licenses >/dev/null 2>&1 || true
RUN "$ANDROID_SDK_ROOT/cmdline-tools/latest/bin/sdkmanager" \
      "platform-tools" "platforms;android-35" "build-tools;35.0.0" \
    && rm -rf /tmp/* /var/tmp/*

# gradle (the repo has no wrapper).
RUN curl -fsSL -o /tmp/gradle.zip \
      "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" \
    && unzip -q /tmp/gradle.zip -d /opt \
    && ln -s "/opt/gradle-${GRADLE_VERSION}/bin/gradle" /usr/local/bin/gradle \
    && rm -f /tmp/gradle.zip

WORKDIR /src
COPY . /src/
# WEBUI_CACHEBUST must change whenever the webui does. The webui is fetched at
# build time from a separate repo, so its contents are invisible to Docker's
# layer cache: without this, `RUN bash build-webui.sh` was CACHED and the APK kept
# shipping the previous app.js (39538 bytes) while the repo had the new one.
ARG WEBUI_CACHEBUST=none
RUN WEBUI_CACHEBUST="${WEBUI_CACHEBUST}" bash build-webui.sh && ls -la app/src/main/assets/webui
RUN gradle --no-daemon assembleRelease

# assembleRelease produces an UNSIGNED apk, which the guest's `adb install`
# rejects ("apk install failed"). Sign it with a throwaway debug key here so the
# published artifact is directly installable.
RUN set -eux; \
    BT="$(ls -d /opt/android-sdk/build-tools/* | sort -V | tail -1)"; \
    keytool -genkeypair -keystore /tmp/debug.keystore -storepass android -keypass android \
      -alias androiddebugkey -dname "CN=Android Debug,O=Android,C=US" -keyalg RSA -keysize 2048 \
      -validity 10000 >/dev/null; \
    "$BT/zipalign" -f 4 app/build/outputs/apk/release/app-release-unsigned.apk /tmp/aligned.apk; \
    "$BT/apksigner" sign --ks /tmp/debug.keystore --ks-pass pass:android --key-pass pass:android \
      --ks-key-alias androiddebugkey --out /easystream.apk /tmp/aligned.apk; \
    "$BT/apksigner" verify /easystream.apk; \
    ls -la /easystream.apk
